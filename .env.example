# --- 서버 기본 설정 --- [cite: 19]
PORT=3001
BUCKET_NAME=your_s3_bucket_name_here
IS_REVEALED=false

# --- 인증 및 보안 (index.js 필수값) ---
# Kakao: https://kauth.kakao.com/.well-known/jwks.json
# Web3Auth: https://authjs.web3auth.io/jwks
JWKS_URI=your_jwks_uri_here
TOKEN_AUDIENCE=your_client_id_or_api_key_here

# --- Web3Auth/Kakao 상세 설정 --- [cite: 20, 21, 22]
WEB3AUTH_CLIENT_ID=your_web3auth_client_id
WEB3AUTH_VERIFIER_ID=kakao-custom-auth
WEB3AUTH_NETWORK=sapphire_devnet
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# --- 블록체인 설정 (수요일 합체용) ---
RPC_URL=your_rpc_url_here
CONTRACT_ADDRESS=0x_your_contract_address_here
PRIVATE_KEY=your_server_wallet_private_key_do_not_share
